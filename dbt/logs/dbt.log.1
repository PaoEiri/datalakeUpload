    FROM "postgres"."staging"."stg_poblacion_sexo"
    GROUP BY anio
)
SELECT *
FROM pivot
WHERE ROUND(COALESCE(hombres, 0) + COALESCE(mujeres, 0), 2) != ROUND(COALESCE(total, 0), 2)
  
  
      
