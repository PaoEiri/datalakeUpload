SELECT
    id_geografia,
    nombre,
    codigo_ine,
    es_codigo_oficial_ine,
    nivel,
    nivel_orden,
    codigo_municipio,
    codigo_provincia,
    codigo_ccaa,
    codigo_pais
FROM "postgres"."reference"."dim_geografia"
  );
  
