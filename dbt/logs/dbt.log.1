    dt.id_tiempo,
    ip.id_geografia,
    ip.precio_m2
FROM "postgres"."intermediate"."int_precios_vivienda_unificado" ip
LEFT JOIN "postgres"."core"."dim_tiempo" dt ON ip.anio = dt.anio AND ip.trimestre = dt.trimestre
  );
  
