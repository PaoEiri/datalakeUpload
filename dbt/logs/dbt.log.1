  as (
    

-- Resuelve id_geografia vía slug_tinsa (URL), NUNCA por el texto de zona
-- (ambiguo: "Málaga" aparece como provincia y como municipio).
SELECT
    sgt.id_geografia,
    t.anio,
    t.trimestre,
    t.precio_m2
FROM "postgres"."staging"."stg_precios_tinsa" t
